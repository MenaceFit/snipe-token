# ============================================================
# SNIPE-TOKEN — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_IDS=123456789,987654321  # comma-separated allowed chat IDs
TELEGRAM_ADMIN_IDS=123456789           # comma-separated admin IDs

# ---- Mode sans serveur (défaut — aucune installation requise) ----
USE_FAKEREDIS=true                        # true = Redis en mémoire, pas besoin d'installer Redis
# DATABASE_URL=sqlite+aiosqlite:///snipe_token.db  # déjà par défaut (SQLite local)

# ---- Database (optionnel — PostgreSQL si tu veux de la persistance robuste) ----
# DATABASE_URL=postgresql+asyncpg://snipe:snipe_password@localhost:5432/snipe_token
# DATABASE_SYNC_URL=postgresql://snipe:snipe_password@localhost:5432/snipe_token

# ---- Redis (optionnel — uniquement si USE_FAKEREDIS=false) ----
# REDIS_URL=redis://localhost:6379/0

# ---- EVM RPCs — Priority 1 Chains ----
# Ethereum
ETH_RPC_WS=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_RPC_HTTP=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_RPC_WS_BACKUP=wss://mainnet.infura.io/ws/v3/YOUR_INFURA_KEY

# Base
BASE_RPC_WS=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_HTTP=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_WS_BACKUP=wss://base.publicnode.com

# Arbitrum
ARB_RPC_WS=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARB_RPC_HTTP=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ARB_RPC_WS_BACKUP=wss://arbitrum-one.publicnode.com

# BNB Chain
BSC_RPC_WS=wss://bsc-rpc.publicnode.com
BSC_RPC_HTTP=https://bsc-dataseed1.binance.org
BSC_RPC_WS_BACKUP=wss://bsc.publicnode.com

# Polygon
POLYGON_RPC_WS=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_RPC_HTTP=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_RPC_WS_BACKUP=wss://polygon-bor-rpc.publicnode.com

# Optimism
OP_RPC_WS=wss://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
OP_RPC_HTTP=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
OP_RPC_WS_BACKUP=wss://optimism.publicnode.com

# Avalanche
AVAX_RPC_WS=wss://avalanche-mainnet.core.chainstack.com/ws/YOUR_KEY
AVAX_RPC_HTTP=https://api.avax.network/ext/bc/C/rpc
AVAX_RPC_WS_BACKUP=wss://avalanche-c-chain-rpc.publicnode.com

# ---- Solana (désactivé — bot EVM uniquement) ----
# SOLANA_RPC_WS=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# SOLANA_RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# SOLANA_RPC_WS_BACKUP=wss://api.mainnet-beta.solana.com

# ---- Priority 2 Chains (Optional) ----
BLAST_RPC_WS=wss://blast-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BLAST_RPC_HTTP=https://blast-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

LINEA_RPC_WS=wss://linea-mainnet.infura.io/ws/v3/YOUR_INFURA_KEY
LINEA_RPC_HTTP=https://linea-mainnet.infura.io/v3/YOUR_INFURA_KEY

ZKSYNC_RPC_WS=wss://mainnet.era.zksync.io/ws
ZKSYNC_RPC_HTTP=https://mainnet.era.zksync.io

SCROLL_RPC_WS=wss://scroll-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SCROLL_RPC_HTTP=https://scroll-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ---- Price Feed APIs ----
DEXSCREENER_BASE_URL=https://api.dexscreener.com
COINGECKO_API_KEY=your_coingecko_api_key
COINGECKO_BASE_URL=https://pro-api.coingecko.com/api/v3
BIRDEYE_API_KEY=your_birdeye_api_key
DEFINED_API_KEY=your_defined_fi_key
MORALIS_API_KEY=your_moralis_api_key

# ---- Copy Trading (LIVE MODE — use with extreme caution) ----
# Only required if COPY_TRADING_LIVE_ENABLED=true
COPY_TRADING_LIVE_ENABLED=false
COPY_TRADING_WALLET_PRIVATE_KEY=  # NEVER share or commit this
COPY_TRADING_WALLET_ADDRESS=
COPY_TRADING_MAX_TRADE_SIZE_USD=100
COPY_TRADING_MAX_DAILY_LOSS_USD=500
COPY_TRADING_MAX_POSITION_SIZE_USD=200
COPY_TRADING_DEFAULT_COPY_PERCENT=5
COPY_TRADING_MAX_SLIPPAGE_BPS=300

# ---- Security ----
API_SECRET_KEY=generate_a_long_random_secret_here
ENCRYPTION_KEY=generate_a_fernet_key_here

# ---- Application ----
ENVIRONMENT=development  # development | production
LOG_LEVEL=INFO
DEBUG=false

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Monitoring ----
PROMETHEUS_PORT=9090
ENABLE_METRICS=true
